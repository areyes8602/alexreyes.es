      "url_enunciado": "/aula/cangur/examenes/2526-cangur-copa-junior-fase1-mati/p12.html",
      "url_pdf": "/aula/cangur/examenes/2526-cangur-copa-junior-fase1-mati/original.pdf#page=2",
      "pages_enunciado": [
        2
